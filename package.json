{
  "name": "scholarship-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bachelor's and master's scholarships for international students, every link pointing at the awarding institution's own site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "collect": "node pipeline/index.mjs",
    "probe": "node pipeline/index.mjs --probe",
    "reprocess": "node pipeline/index.mjs --from-cache",
    "registry": "node scripts/build-registry.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "verify": "node scripts/verify-index.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "node-html-parser": "^7.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
